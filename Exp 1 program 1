# Iterative Insertion Sort

def insertion_sort_iterative(arr):
    n = len(arr)

    for i in range(1, n):
        key = arr[i]
        j = i - 1

        while j >= 0 and arr[j] > key:
            arr[j + 1] = arr[j]
            j = j - 1

        arr[j + 1] = key

    return arr


# Recursive Insertion Sort

def insertion_sort_recursive(arr, n):
    if n <= 1:
        return

    insertion_sort_recursive(arr, n - 1)

    key = arr[n - 1]
    j = n - 2

    while j >= 0 and arr[j] > key:
        arr[j + 1] = arr[j]
        j = j - 1

    arr[j + 1] = key


# Main
arr1 = [8, 4, 2, 9, 5]
arr2 = [8, 4, 2, 9, 5]

print("Original Array:", arr1)

print("Iterative Insertion Sort:",
      insertion_sort_iterative(arr1))

insertion_sort_recursive(arr2, len(arr2))
print("Recursive Insertion Sort:", arr2)
