def counting_sort(a):
    count = [0] * (max(a) + 1)

    for x in a:
        count[x] += 1

    result = []
    for i in range(len(count)):
        result += [i] * count[i]

    return result


a = list(map(int, input("Enter non-negative integers: ").split()))
print("Sorted array:", counting_sort(a))
